# binarios y objetos de compilación (Pascal/C/C++/Java, etc.)
*.o
*.obj
*.exe
*.class
*.ppu

# ejecutables sin extensión que genera fpc (mismo nombre que el .pas)
**/practica-*/*
!**/practica-*/*.*
!**/practica-*/*/
**/practica-*/*.o
**/practica-*/*.obj
**/practica-*/*.exe

